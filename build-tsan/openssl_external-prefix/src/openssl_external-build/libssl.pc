# This file should be used when building against this OpenSSL build, and should never be installed
prefix=/Users/conycqzhang/Learning/Work/OpenRead/build-tsan/openssl_external-prefix/src/openssl_external-build
exec_prefix=${prefix}
libdir=${exec_prefix}
includedir=${prefix}/include ${prefix}/../../../../third_party/openssl/include

Name: OpenSSL-libssl
Description: Secure Sockets Layer and cryptography libraries
Version: 4.0.2
Requires.private: libcrypto
Libs: -L${libdir} -lssl
Cflags: -I${prefix}/include  -I${prefix}/../../../../third_party/openssl/include
