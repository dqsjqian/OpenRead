# This file should be used when building against this OpenSSL build, and should never be installed
prefix=/Users/conycqzhang/Learning/Work/OpenRead/build-asan/openssl_external-prefix/src/openssl_external-build
exec_prefix=${prefix}
libdir=${exec_prefix}
includedir=${prefix}/include ${prefix}/../../../../third_party/openssl/include
modulesdir=${libdir}/providers

Name: OpenSSL-libcrypto
Description: OpenSSL cryptography library
Version: 4.0.2
Libs: -L${libdir} -lcrypto
Libs.private: 
Cflags: -I${prefix}/include  -I${prefix}/../../../../third_party/openssl/include
